<Page
    x:Class="Shasta.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shasta.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- GridView (not ListView) — square cover tiles in a wrapping grid,
         Groove Music's "Albums" layout rather than a text-first row list.
         GridView's default panel virtualizes just like ListView's, so this
         is still safe on old hardware. See
         wp-apps/03-design-visual-e-navegacao.md#padrões-de-tela-referência-rápida. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,16,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LibraryTitleText"
                       Grid.Column="0"
                       Style="{StaticResource TitleTextBlockStyle}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <!-- Flat icon+text button, no Flyout chrome beyond the
                 default — covers the "filters I can change" ask with a
                 sort choice, without building a full filter subsystem. -->
            <Button x:Name="SortButton"
                    Grid.Column="1"
                    Style="{StaticResource FlatIconButtonStyle}"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <FontIcon Glyph="&#xE8CB;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock x:Name="SortButtonText" Text="Title" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Title" Click="SortByTitle_Click" />
                        <MenuFlyoutItem Text="Author" Click="SortByAuthor_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Style="{StaticResource BodyTextBlockStyle}"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="16,0,16,16"
                   VerticalAlignment="Top" />

        <GridView x:Name="ItemsListView"
                  Grid.Row="1"
                  Padding="8,0,8,16"
                  Visibility="Collapsed"
                  IsItemClickEnabled="True"
                  ItemClick="ItemsListView_ItemClick"
                  ContainerContentChanging="ItemsListView_ContainerContentChanging">
            <!-- Only takes effect when ItemsSource is a grouped
                 ICollectionView (Author sort) — ignored for a plain flat
                 list (Title sort), so one GridView covers both without a
                 XAML-level branch. -->
            <GridView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Key}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       Margin="8,20,8,4" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </GridView.GroupStyle>
            <GridView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="150" Margin="8">
                        <!-- No Background binding — covers need an
                             authenticated fetch (see
                             LibraryService.LoadCoverAsync), not a bare URI
                             a XAML Binding could point at. Loaded
                             imperatively per-tile from
                             ContainerContentChanging in the code-behind,
                             the standard UWP pattern for async images
                             inside a virtualized GridView. Square, no
                             CornerRadius — flat Groove Music look, and it
                             sidesteps the Control.CornerRadius runtime trap
                             entirely (see App.xaml's button styles). -->
                        <Border x:Name="CoverImage"
                                Width="150" Height="150"
                                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" />
                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Author}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.7"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>

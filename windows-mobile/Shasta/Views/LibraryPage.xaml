<Page
    x:Class="Shasta.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shasta.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- ListView (not a hand-built StackPanel of cards) — library item
         counts can be non-trivial, and ListView's default virtualizing
         panel matters on old hardware. See
         wp-apps/03-design-visual-e-navegacao.md#padrões-de-tela-referência-rápida. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="LibraryTitleText"
                   Grid.Row="0"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Margin="16,16,16,8"
                   TextTrimming="CharacterEllipsis" />

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Style="{StaticResource BodyTextBlockStyle}"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="16,0,16,16"
                   VerticalAlignment="Top" />

        <ListView x:Name="ItemsListView"
                  Grid.Row="1"
                  Padding="12,0,12,16"
                  Visibility="Collapsed"
                  IsItemClickEnabled="True"
                  ItemClick="ItemsListView_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0"
                                   Source="{Binding CoverUri}"
                                   Width="56" Height="56"
                                   Stretch="UniformToFill" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Author}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Opacity="0.7"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

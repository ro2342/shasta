<Page
    x:Class="Shasta.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shasta.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="16,16,16,24">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Shasta" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />
            <TextBlock Text="Log in to your Audiobookshelf server."
                       Style="{StaticResource BodyTextBlockStyle}"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Margin="0,0,0,24" />

            <TextBlock Text="Server address" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,4" />
            <TextBox x:Name="ServerUrlBox"
                     PlaceholderText="https://abs.example.com"
                     InputScope="Url"
                     TextChanged="ServerUrlBox_TextChanged"
                     Margin="0,0,0,4" />
            <TextBlock x:Name="HttpWarningText"
                       Text="⚠ This address is not encrypted (http). Your password will be sent unprotected over the network."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,0,0,20" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <RadioButton x:Name="PasswordModeRadio"
                             Content="Username &amp; password"
                             GroupName="LoginMode"
                             IsChecked="True"
                             Checked="LoginMode_Checked" />
                <RadioButton x:Name="ApiKeyModeRadio"
                             Content="API key"
                             GroupName="LoginMode"
                             Checked="LoginMode_Checked"
                             Margin="20,0,0,0" />
            </StackPanel>

            <StackPanel x:Name="PasswordPanel">
                <TextBlock Text="Username" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,4" />
                <TextBox x:Name="UsernameBox" Margin="0,0,0,16" />
                <TextBlock Text="Password" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,16" />
            </StackPanel>

            <StackPanel x:Name="ApiKeyPanel" Visibility="Collapsed">
                <TextBlock Text="API key" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,4" />
                <PasswordBox x:Name="ApiKeyBox" Margin="0,0,0,16" />
            </StackPanel>

            <TextBlock x:Name="StatusText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,0,0,16" />

            <Button x:Name="LoginButton"
                    Content="Log In"
                    Click="LoginButton_Click"
                    HorizontalAlignment="Stretch" />
        </StackPanel>
    </ScrollViewer>
</Page>

<Page
    x:Class="Shasta.Views.ItemDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shasta.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="16,16,16,24">
        <StackPanel>
            <!-- Border+ImageBrush (not Image) — see
                 LibraryService.LoadCoverAsync(Border, ...). Square, no
                 CornerRadius, matches the flat Groove Music look used
                 across the app. -->
            <Border x:Name="CoverImage"
                    Width="220" Height="220"
                    Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20" />

            <TextBlock x:Name="TitleText"
                       Style="{StaticResource TitleTextBlockStyle}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4" />
            <TextBlock x:Name="AuthorText"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4" />
            <TextBlock x:Name="SeriesText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"
                       Margin="0,0,0,20" />

            <!-- Primary "Play" action + a square icon-only Download button
                 beside it — flat accent fill, no rounding. -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayButton"
                        Grid.Column="0"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Click="PlayButton_Click"
                        Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Glyph="&#xE768;" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock x:Name="PlayButtonText" Text="Play" />
                    </StackPanel>
                </Button>
                <Button x:Name="DownloadButton"
                        Grid.Column="1"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Click="DownloadButton_Click">
                    <FontIcon x:Name="DownloadButtonIcon" Glyph="&#xE896;" FontSize="18" />
                </Button>
            </Grid>
            <TextBlock x:Name="DownloadStatusText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,8,0,0" />

            <TextBlock x:Name="ProgressStatusText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,8,0,0" />

            <Border Style="{StaticResource SectionDividerStyle}" />

            <!-- Label/value metadata rows, like ABS's AUTHOR/SERIES/DURATION
                 block on item detail — a quick scan strip above the
                 description instead of the author/series text being the
                 only structured metadata on screen. -->
            <StackPanel x:Name="MetaPanel" Margin="0,0,0,20">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="AUTHOR" Style="{StaticResource MetaLabelTextStyle}" />
                    <TextBlock x:Name="MetaAuthorText" Grid.Column="1" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                </Grid>
                <Grid x:Name="MetaSeriesRow" Margin="0,0,0,10" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SERIES" Style="{StaticResource MetaLabelTextStyle}" />
                    <TextBlock x:Name="MetaSeriesText" Grid.Column="1" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="DURATION" Style="{StaticResource MetaLabelTextStyle}" />
                    <TextBlock x:Name="MetaDurationText" Grid.Column="1" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>

            <TextBlock x:Name="DescriptionText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" Margin="0,0,0,16" />

            <TextBlock x:Name="ChaptersTitle"
                       Text="Chapters"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Visibility="Collapsed"
                       Margin="0,0,0,12" />
            <StackPanel x:Name="ChaptersPanel" Visibility="Collapsed" />

            <TextBlock x:Name="StatusText"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Opacity="0.7"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>

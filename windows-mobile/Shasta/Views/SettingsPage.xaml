<Page
    x:Class="Shasta.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shasta.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <!-- Continuous-bar illusion from the section title into the Pivot
             tabs, matching native Settings — see
             wp-apps/03-design-visual-e-navegacao.md#pivot-para-abas-dentro-de-uma-tela. -->
        <Border Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                Height="48"
                VerticalAlignment="Top" />

        <Pivot Title="Settings">
            <PivotItem Header="Server">
                <ScrollViewer Padding="16,16,16,24">
                    <StackPanel>
                        <TextBlock Text="Server address" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,4" />
                        <TextBlock x:Name="ServerUrlText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" Margin="0,0,0,16" />
                        <TextBlock Text="Logged in as" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,4" />
                        <TextBlock x:Name="UsernameText" Style="{StaticResource BodyTextBlockStyle}" Margin="0,0,0,20" />
                        <Button x:Name="LogoutButton" Content="Log Out" Click="LogoutButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Appearance">
                <ScrollViewer Padding="16,16,16,24">
                    <StackPanel>
                        <TextBlock Text="Theme" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ThemeLightButton" Content="Light" Tag="light" Click="ThemeMode_Click" Margin="0,0,8,0" />
                            <Button x:Name="ThemeDarkButton" Content="Dark" Tag="dark" Click="ThemeMode_Click" Margin="0,0,8,0" />
                            <Button x:Name="ThemeAutoButton" Content="Auto" Tag="auto" Click="ThemeMode_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Advanced">
                <ScrollViewer Padding="16,16,16,24">
                    <StackPanel>
                        <TextBlock Text="Updates" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12" />
                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource BodyTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <ProgressBar x:Name="UpdateProgressBar" Visibility="Collapsed" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Button x:Name="CheckUpdateButton" Content="Check for Updates" Click="CheckUpdateButton_Click" Margin="0,0,8,0" />
                            <Button x:Name="DownloadUpdateButton" Content="Download Update" Click="DownloadUpdateButton_Click" Visibility="Collapsed" Margin="0,0,8,0" />
                            <Button x:Name="InstallUpdateButton" Content="Install" Click="InstallUpdateButton_Click" Visibility="Collapsed" />
                        </StackPanel>

                        <Border Style="{StaticResource SectionDividerStyle}" />

                        <TextBlock Text="Danger zone" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12" />
                        <Button x:Name="ClearDownloadsButton"
                                Content="Clear all downloads"
                                Click="ClearDownloadsButton_Click"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,12" />
                        <Button x:Name="ResetAppButton"
                                Content="Reset app (sign out and erase local data)"
                                Click="ResetAppButton_Click"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>

<Page
    x:Class="Shasta.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shasta.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="16,16,16,24">
        <StackPanel>
            <TextBlock x:Name="StatusText"
                       Text="Loading…"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <TextBlock x:Name="ContinueListeningTitle"
                       Text="Continue Listening"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Visibility="Collapsed"
                       Margin="0,0,0,12" />
            <!-- Horizontal shelf (cover-first cards), not a vertical list —
                 matches the "Continue Listening"/"Discover" shelf pattern
                 in the official Audiobookshelf app. Nested inside the
                 page's own vertical ScrollViewer, so scroll direction is
                 locked to horizontal here specifically. -->
            <ScrollViewer x:Name="ContinueListeningScroller"
                          HorizontalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled"
                          Visibility="Collapsed"
                          Margin="0,0,0,24">
                <StackPanel x:Name="ContinueListeningPanel" Orientation="Horizontal" />
            </ScrollViewer>

            <TextBlock x:Name="LibrariesTitle"
                       Text="Libraries"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Visibility="Collapsed"
                       Margin="0,8,0,12" />
            <StackPanel x:Name="LibrariesPanel" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>

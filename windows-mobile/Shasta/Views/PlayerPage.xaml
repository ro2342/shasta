<Page
    x:Class="Shasta.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shasta.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="16,16,16,24">
        <StackPanel>
            <Image x:Name="CoverImage"
                   Width="220" Height="220"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20" />

            <TextBlock x:Name="TitleText"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,4" />
            <TextBlock x:Name="AuthorText"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,20" />

            <Slider x:Name="PositionSlider"
                    Minimum="0"
                    ValueChanged="PositionSlider_ValueChanged"
                    Margin="0,0,0,4" />
            <Grid Margin="0,0,0,20">
                <TextBlock x:Name="CurrentTimeText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" HorizontalAlignment="Left" />
                <TextBlock x:Name="DurationText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" HorizontalAlignment="Right" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Button x:Name="SkipBackButton" Content="-15s" Click="SkipBackButton_Click" Margin="0,0,8,0" />
                <Button x:Name="PlayPauseButton" Content="Pause" Click="PlayPauseButton_Click" Margin="0,0,8,0" />
                <Button x:Name="SkipForwardButton" Content="+30s" Click="SkipForwardButton_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Speed" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox x:Name="SpeedComboBox" SelectionChanged="SpeedComboBox_SelectionChanged">
                    <ComboBoxItem Content="0.8x" Tag="0.8" />
                    <ComboBoxItem Content="1x" Tag="1.0" />
                    <ComboBoxItem Content="1.25x" Tag="1.25" />
                    <ComboBoxItem Content="1.5x" Tag="1.5" />
                    <ComboBoxItem Content="1.75x" Tag="1.75" />
                    <ComboBoxItem Content="2x" Tag="2.0" />
                </ComboBox>
            </StackPanel>

            <Border Style="{StaticResource SectionDividerStyle}" />

            <TextBlock x:Name="ChaptersTitle"
                       Text="Chapters"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Visibility="Collapsed"
                       Margin="0,0,0,12" />
            <StackPanel x:Name="ChaptersPanel" Visibility="Collapsed" />

            <TextBlock x:Name="StatusText"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Opacity="0.7"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>

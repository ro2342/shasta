<Page
    x:Class="Shasta.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shasta.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="16,16,16,24">
        <StackPanel>
            <!-- Border+ImageBrush (not Image) for rounded corners — see
                 LibraryService.LoadCoverAsync(Border, ...). -->
            <Border x:Name="CoverImage"
                    Width="240" Height="240"
                    CornerRadius="16"
                    Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20" />

            <TextBlock x:Name="TitleText"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,4" />
            <TextBlock x:Name="AuthorText"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,20" />

            <Slider x:Name="PositionSlider"
                    Minimum="0"
                    ValueChanged="PositionSlider_ValueChanged"
                    Margin="0,0,0,4" />
            <Grid Margin="0,0,0,20">
                <TextBlock x:Name="CurrentTimeText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" HorizontalAlignment="Left" />
                <TextBlock x:Name="DurationText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" HorizontalAlignment="Right" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                <Button x:Name="SkipBackButton"
                        Style="{StaticResource TransportIconButtonStyle}"
                        Click="SkipBackButton_Click"
                        Margin="0,0,16,0">
                    <StackPanel>
                        <FontIcon Glyph="&#xE76B;" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Text="15s" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="PlayPauseButton"
                        Style="{StaticResource CirclePlayButtonStyle}"
                        Click="PlayPauseButton_Click"
                        Margin="0,0,16,0">
                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE769;" FontSize="28" />
                </Button>
                <Button x:Name="SkipForwardButton"
                        Style="{StaticResource TransportIconButtonStyle}"
                        Click="SkipForwardButton_Click">
                    <StackPanel>
                        <FontIcon Glyph="&#xE76C;" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Text="30s" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Bottom icon bar (Chapters toggle / Speed) — same idea as
                 the Chapters/Downloads/Speed/Sleep row in Lissen's player,
                 replacing the old always-inline Speed ComboBox + an
                 always-expanded chapters list further down the page. -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ChaptersToggleButton"
                        Grid.Column="0"
                        Style="{StaticResource PlayerBottomBarButtonStyle}"
                        Click="ChaptersToggleButton_Click"
                        IsEnabled="False">
                    <StackPanel>
                        <FontIcon Glyph="&#xE8FD;" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="Chapters" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.8" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Button>
                <Grid Grid.Column="1">
                    <Button x:Name="SpeedButton"
                            Style="{StaticResource PlayerBottomBarButtonStyle}">
                        <StackPanel>
                            <FontIcon Glyph="&#xE916;" FontSize="18" HorizontalAlignment="Center" />
                            <TextBlock x:Name="SpeedButtonText" Text="1x" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.8" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout>
                                <ComboBox x:Name="SpeedComboBox" Header="Playback speed" SelectionChanged="SpeedComboBox_SelectionChanged">
                                    <ComboBoxItem Content="0.8x" Tag="0.8" />
                                    <ComboBoxItem Content="1x" Tag="1.0" />
                                    <ComboBoxItem Content="1.25x" Tag="1.25" />
                                    <ComboBoxItem Content="1.5x" Tag="1.5" />
                                    <ComboBoxItem Content="1.75x" Tag="1.75" />
                                    <ComboBoxItem Content="2x" Tag="2.0" />
                                </ComboBox>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Grid>

            <Border Style="{StaticResource SectionDividerStyle}" />

            <TextBlock x:Name="ChaptersTitle"
                       Text="Chapters"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Visibility="Collapsed"
                       Margin="0,0,0,12" />
            <StackPanel x:Name="ChaptersPanel" Visibility="Collapsed" />

            <TextBlock x:Name="StatusText"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Opacity="0.7"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>

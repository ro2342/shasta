<?xml version="1.0" encoding="utf-8"?>
<!--
  The certificate Subject generated by the sideload-cert workflow (see
  .github/workflows/windows-mobile-cert.yml) must match Identity/@Publisher
  below EXACTLY, char for char.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  IgnorableNamespaces="uap uap3 mp">

  <Identity
    Name="ro2342.Shasta"
    Publisher="CN=ro2342-Shasta-SelfSigned"
    Version="1.0.18.0" />

  <mp:PhoneIdentity PhoneProductId="0b7533ef-58c5-428c-a3b5-d0f456524215" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Shasta</DisplayName>
    <PublisherDisplayName>ro2342</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!--
      MinVersion/MaxVersionTested are rewritten by MSBuild from the csproj's
      TargetPlatformMinVersion/TargetPlatformVersion at build time.
      Windows.Universal (not Windows.Mobile) so the local x64 dev config can
      also install/debug on desktop Windows — ARM remains the only shipped
      bundle (AppxBundlePlatforms in the csproj).
    -->
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.14393.0" MaxVersionTested="10.0.17763.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="Shasta.App">
      <uap:VisualElements
        DisplayName="Shasta"
        Description="An Audiobookshelf client for Windows 10 Mobile."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="transparent" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- internetClient covers HttpClient use — server login, library/API
         calls, streaming, downloads, and the sideload update checker. -->
    <Capability Name="internetClient" />
    <!-- Resolves the previously-flagged open risk: even the modern
         single-process MediaPlayer model needs this declared, or the OS
         never registers the app's System Media Transport Controls as an
         active media session at all — confirmed by a real device never
         showing a "now playing" title on the volume-button overlay
         (the same overlay any music/podcast app gets), and by
         Microsoft's own background-audio documentation. uap3 is the
         Windows.Foundation.UniversalApiContract version introduced
         exactly at 10.0.14393.0 (Anniversary Update), so it's available
         at this app's minimum target with no extra version cost. -->
    <uap3:Capability Name="backgroundMediaPlayback" />
  </Capabilities>

</Package>

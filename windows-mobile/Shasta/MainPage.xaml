<Page
    x:Class="Shasta.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shasta"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
      Standard shell: HeaderBar (hamburger + section title) OUTSIDE the
      SplitView, as a sibling in its own row above — so it's never covered
      by the sliding pane. See "Shell do app" in
      wp-apps/03-design-visual-e-navegacao.md.
    -->
    <Page.Resources>
        <!-- UWP's default Button has rounded/inset chrome on Pressed/
             PointerOver — this template makes the highlight fill the
             entire row (same brushes as a selected ListViewItem), no
             rounded corners or leftover margin. -->
        <Style x:Key="NavRowStyle" TargetType="Button">
            <Setter Property="Padding" Value="20,14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SystemControlBackgroundListLowBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SystemControlBackgroundListMediumBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Padding="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HamburgerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Visibility="Collapsed" during onboarding (see
             BeginOnboarding/CompleteOnboarding in the code-behind) — no
             header/hamburger before the user is logged in. -->
        <Grid x:Name="HeaderBar" Grid.Row="0"
              Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="MenuButton"
                    Grid.Column="0"
                    Click="MenuButton_Click"
                    Style="{StaticResource HamburgerButtonStyle}">
                <!-- FontIcon with a raw glyph (Segoe MDL2 Assets), NEVER
                     SymbolIcon Symbol="GlobalNavigationButton" — that enum
                     member doesn't exist on older device runtimes even
                     with a newer build SDK. See
                     wp-apps/03-design-visual-e-navegacao.md#ícones. -->
                <FontIcon Glyph="&#xE700;" />
            </Button>
            <TextBlock x:Name="HeaderTitleText"
                       Grid.Column="1"
                       Style="{StaticResource BodyTextBlockStyle}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="12,0,16,0" />
        </Grid>

        <SplitView x:Name="NavSplitView"
                   Grid.Row="1"
                   DisplayMode="Overlay"
                   PanePlacement="Left"
                   OpenPaneLength="248"
                   IsPaneOpen="False">
            <SplitView.Pane>
                <Grid Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Main sections -->
                    <StackPanel Grid.Row="0" Margin="0,32,0,0">
                        <Button x:Name="NavHome" Tag="Home" Click="NavItem_Click" Style="{StaticResource NavRowStyle}">
                            <StackPanel Orientation="Horizontal">
                                <SymbolIcon x:Name="NavHomeIcon" Symbol="Home" />
                                <TextBlock x:Name="NavHomeLabel" Text="Home" Margin="20,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavLibrary" Tag="Library" Click="NavItem_Click" Style="{StaticResource NavRowStyle}">
                            <StackPanel Orientation="Horizontal">
                                <!-- SymbolIcon Symbol="Library" is one of the
                                     baseline-safe enum members. -->
                                <SymbolIcon x:Name="NavLibraryIcon" Symbol="Library" />
                                <TextBlock x:Name="NavLibraryLabel" Text="Library" Margin="20,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavDownloads" Tag="Downloads" Click="NavItem_Click" Style="{StaticResource NavRowStyle}">
                            <StackPanel Orientation="Horizontal">
                                <!-- FontIcon (glyph "Download") instead of
                                     SymbolIcon — not in the baseline-safe
                                     enum set. -->
                                <FontIcon x:Name="NavDownloadsIcon" Glyph="&#xE896;" FontSize="16" />
                                <TextBlock x:Name="NavDownloadsLabel" Text="Downloads" Margin="20,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Utility item, separated by a full-width divider —
                         just Settings, no Profile/Sync (out of scope). -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <Border Height="1" Margin="0,0,0,8" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                        <Button x:Name="NavSettings" Tag="Settings" Click="NavItem_Click" Style="{StaticResource NavRowStyle}">
                            <StackPanel Orientation="Horizontal">
                                <SymbolIcon x:Name="NavSettingsIcon" Symbol="Setting" />
                                <TextBlock x:Name="NavSettingsLabel" Text="Settings" Margin="20,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </SplitView.Pane>

            <SplitView.Content>
                <Grid>
                    <Frame x:Name="ContentFrame" x:FieldModifier="public" />

                    <!-- Floats over the bottom of whatever page is showing
                         when something is playing — additive to the shell,
                         no restructuring needed. Hidden while PlayerPage
                         itself is current (see MainPage.xaml.cs) to avoid a
                         player-inside-a-player. -->
                    <Border x:Name="MiniPlayerBar"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                            Padding="12,8"
                            Visibility="Collapsed"
                            Tapped="MiniPlayerBar_Tapped">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="MiniPlayerCover" Grid.Column="0" Width="40" Height="40" CornerRadius="6"
                                    Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" />
                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="MiniPlayerTitleText" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MiniPlayerAuthorText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button x:Name="MiniPlayerPlayPauseButton" Grid.Column="2" Click="MiniPlayerPlayPauseButton_Click" VerticalAlignment="Center">
                                <FontIcon x:Name="MiniPlayerPlayPauseIcon" Glyph="&#xE769;" FontSize="16" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border x:Name="ErrorPanel"
                            Visibility="Collapsed"
                            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                            Padding="20">
                        <TextBlock x:Name="ErrorText"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource BodyTextBlockStyle}" />
                    </Border>

                    <!-- Closes the pane when tapping outside it (manual
                         light-dismiss — SplitView doesn't do this on its
                         own). -->
                    <Border x:Name="PaneDismissOverlay"
                            Background="Transparent"
                            Visibility="Collapsed"
                            Tapped="PaneDismissOverlay_Tapped" />
                </Grid>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Page>

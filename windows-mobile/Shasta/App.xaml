<Application
    x:Class="Shasta.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <!--
          Shared styles across native pages, no custom color palette by
          default — just visual grouping reusing UWP's own theme brushes
          (light/dark + the user's accent color come for free).
        -->
        <!-- Square, flat — no CornerRadius. The whole app follows the
             flat/square Groove Music look (sharp corners everywhere, solid
             accent-color fills instead of rounded pills/circles) rather
             than mixing that with the earlier rounded-corner pass; see
             the "Erros já vistos" note in wp-apps/07-build-e-ci-cd.md and
             PrimaryActionButtonStyle's comment below for why sharp corners
             are also the lower-risk choice on this runtime. -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="NudgeBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <!-- Thin divider between sections within the same screen — closer
             to a native settings list than a card. -->
        <Style x:Key="SectionDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,20,0,20" />
            <Setter Property="Background" Value="{ThemeResource SystemControlForegroundBaseLowBrush}" />
        </Style>

        <!-- No x:Key: applies implicitly to every PivotHeaderItem in the
             app — small tab-label font, matching native Settings. -->
        <Style TargetType="PivotHeaderItem">
            <Setter Property="FontSize" Value="16" />
        </Style>

        <!--
          Groove Music-style flat/square action buttons (superseding an
          earlier rounded-pill/circle pass — see the design-consistency
          note in wp-apps/03-design-visual-e-navegacao.md). No custom
          ControlTemplate and no CornerRadius Setter anywhere below: the
          stock Button chrome on 10.0.14393.0 is already flat and
          essentially square (this predates the Fluent rounded-corner
          redesign, which only landed with Control.CornerRadius itself in
          10.0.17763.0/RS5 — see that lesson in
          wp-apps/07-build-e-ci-cd.md#erros-já-vistos). Relying on the
          platform's own default template is simpler AND safer than a
          hand-rolled one: zero risk of hitting an API that doesn't exist
          on real Anniversary Update hardware.
        -->
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SystemControlHighlightAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- Secondary square icon button next to the primary action
             (Download, overflow) — quiet fill, no border. -->
        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- The big square transport button on PlayerPage — Groove Now
             Playing has no filled play button at all (flat icon row), but
             a filled accent square keeps play/pause the obvious primary
             action while staying flat/square like the rest of the app. -->
        <Style x:Key="BigPlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SystemControlHighlightAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="72" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Flat skip-back/skip-forward buttons flanking the big square —
             transparent, no fill, matches Groove's plain icon transport
             row. -->
        <Style x:Key="TransportIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Bottom icon+label cells on PlayerPage (Chapters / Speed) —
             transparent, stacked content. -->
        <Style x:Key="PlayerBottomBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- General-purpose flat icon(+text) button — header actions like
             LibraryPage's Sort button. Transparent, no border, relies on
             the stock template's own Pressed/PointerOver feedback. -->
        <Style x:Key="FlatIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Label/value metadata row on item detail (AUTHOR/SERIES/…). -->
        <Style x:Key="MetaLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </Application.Resources>

</Application>

<Application
    x:Class="Shasta.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <!--
          Shared styles across native pages, no custom color palette by
          default — just visual grouping reusing UWP's own theme brushes
          (light/dark + the user's accent color come for free).
        -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="NudgeBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <!-- Thin divider between sections within the same screen — closer
             to a native settings list than a card. -->
        <Style x:Key="SectionDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,20,0,20" />
            <Setter Property="Background" Value="{ThemeResource SystemControlForegroundBaseLowBrush}" />
        </Style>

        <!-- No x:Key: applies implicitly to every PivotHeaderItem in the
             app — small tab-label font, matching native Settings. -->
        <Style TargetType="PivotHeaderItem">
            <Setter Property="FontSize" Value="16" />
        </Style>
    </Application.Resources>

</Application>
